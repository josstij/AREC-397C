**## Day 1 family model - 584, taste-first path
********************************************************************************

	replace				family_pref = .
	replace				family_pref = d1_pref_lemon_family if day == 1

	reg					d1_dwtp_3b_584 ///
							family_pref ///
							flavor_low ///
							sweet_high ///
							sugar_high ///
							ingred_high ///
							health_high ///
							magn_know_high, robust

