********************************************************************************

* Blueberry preferred flavor indicator
	capture drop		d2_pref_blueberry
	gen					d2_pref_blueberry = flavor_pref1_1 ///
							if day == 2 & !missing(flavor_pref1_1)

	label var			d2_pref_blueberry ///
