{txt}
{com}. 
.         label                                   define product_labels ///
>                                                                 584 "UA Lemon-Lime" ///
>                                                                 793 "Gatorade Lemon-Lime" ///
>                                                                 356 "Blueberry" ///
>                                                                 831 "Pineapple"
{txt}
{com}. 
.         label                                   values product_id product_labels
{txt}
