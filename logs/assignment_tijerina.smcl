. **## 7.5 - Figure 5: WTP by age group
.         gen                             age_group = .
{txt}(70 missing values generated)

{com}.         replace                         age_group = 1 if age < 25
{txt}(54 real changes made)

{com}.         replace                         age_group = 2 if age >= 25 & age < 40
{txt}(7 real changes made)

{com}.         replace                         age_group = 3 if age >= 40
{txt}(9 real changes made)

{com}. 
.         label                           define agegrp 1 "Under 25" 2 "25-39" 3 "40+"
{txt}
{com}.         label                           values age_group agegrp
{txt}
{com}. 
.         graph                           bar (mean) wtp_after_info, over(age_group) ///
>                                                 title("Figure 5: WTP by Age Group") ///
>                                                 ytitle("WTP ($)")
