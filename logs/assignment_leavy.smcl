. graph bar mean, ///
>     over(outcome, label(angle(35) labsize(small))) ///
>     blabel(bar) ///
>     legend(off) ///
>     ytitle("Mean importance (0 to 100)") ///
>     title("Panel C. Importance of magnesium benefits") ///
>     graphregion(color(white)) ///
>     plotregion(color(white)) ///
>     name(g_info_benefits, replace)
{res}{txt}
