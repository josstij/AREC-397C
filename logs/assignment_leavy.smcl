. **# Render a clean descriptive table by gender
. ********************************************************************************
. 
.         preserve
{txt}
{com}. 
.         keep if                 day1
{txt}(73 observations deleted)

{com}.         keep                    gender d1_diff_wtp_info d1_diff_flavor_like d1_diff_sweet_like
{txt}
{com}. 
.         gen                     obs_id = _n
{txt}
{com}. 
.         rename                  d1_diff_wtp_info      h2_outcome1
{res}{txt}
{com}.         rename                  d1_diff_flavor_like   h2_outcome2
{res}{txt}
{com}.         rename                  d1_diff_sweet_like    h2_outcome3
{res}{txt}
{com}. 
.         reshape                 long h2_outcome, i(obs_id gender) j(h2_measure)
{res}{txt}(j = 1 2 3)

Data{col 36}Wide{col 43}->{col 48}Long
{hline 77}
Number of observations     {res}          70   {txt}->   {res}210         
{txt}Number of variables        {res}           5   {txt}->   {res}4           
{txt}j variable (3 values)                     ->   {res}h2_measure
{txt}xij variables:
    {res}h2_outcome1 h2_outcome2 h2_outcome3   {txt}->   {res}h2_outcome
{txt}{hline 77}

{com}. 
.         label                   define h2_measure_lbl ///
>                                         1 "Informed WTP difference (lab - competitor)" ///
