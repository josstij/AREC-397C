{txt}(73 missing values generated)

{com}.         gen             d1_diff_refresh      = d1_mag_refresh      - d1_nomag_refresh      if day1
{txt}(73 missing values generated)

{com}. 
.         label var       d1_diff_overall_like "Day 1: 584 minus 793 overall liking"
{txt}
{com}.         label var       d1_diff_flavor_like  "Day 1: 584 minus 793 flavor liking"
{txt}
