{com}.         
. ***********************************************************************
. **# addressing hypotheses
. ***********************************************************************
.         
.         
. *** first we need to determine what vars should be inspected based on 
. *the hypotheses
. 
. *** Hypotheses 1:
. * This one primarily concerns magnesium and flavor
. *********
. /* NULL HYPOTHESIS
> After controlling for sugar
> level, consumer choices, purchase likelihood, and WTP are driven primarily by flavor liking and perceived sweetness. 
> Magnesium information and higher magnesium content in the lab-produced
> beverage do not meaningfully change the probability that a participant 
> would choose the lab beverage over the competitor or the WTP for it.
> *********
> ALT HYPOTHESIS 
> Alternatively, we can state that magnesium functionality
> information and higher magnesium content increase the probability 
> that the lab-produced beverage is chosen and raise WTP and 
> purchase likelihood for it, while flavor liking and perceived sweetness remain
> important but not exclusively dominant drivers of choice.
> 
> *** Hypothesis 2
> *********
> NULL HYPOTHESIS
> Our null hypothesis is
> that males and females respond the same way and magnesium does not increase willingness to pay beyond flavor and sweetness
> *********
> ALT HYPOTHESIS
> Magnesium increases willingness to pay more for females than males, or for participants who exercise more, showing that functional benefits like
> magnesium can influence choices differently depending on gender and activity level.
> */
. ********************************************************************************
. **# Defining vars
. ********************************************************************************
. 
. **# Hyopthesis 1
. 
. ********************************************************************************
. **## 1. Clean var names
. ********************************************************************************
. 
. * fixing typos
.         cap                     rename Sure_2b_793 sure_2b_793
{txt}
{com}.         cap                     rename sensory_831_slat sensory_831_salt
{txt}
{com}.         cap                     rename mag_benefit_3b_d1_musle mag_benefit_3b_d1_muscle
{txt}
{com}.         cap             rename preknow_5_magn preknow_magn
{txt}
{com}.         
. **## Setting up the sample structure
. 
.         gen             byte day1 = !missing(sensory_584_overall) ///
>                 | !missing(sensory_793_overall)
{txt}
{com}.         label var       day1 "Day 1 sample: lemon-lime 584 vs 793"
{txt}
{com}.         gen                     byte day2 = !missing(sensory_356_overall) ///
>                                 | !missing(sensory_831_overall)
{txt}
{com}.         label var       day2 "Day 2 sample: 356 vs 831"
{txt}
{com}.         
. * Day 1 wave
.         
.         gen             byte d1_tastefirst = !missing(wtp_2b_584) | !missing(wtp_2b_793)
{txt}
{com}.         label var       d1_tastefirst "Day 1: tasted first, WTP before magnesium info"
{txt}
{com}. 
.         gen             byte d1_infofirst = !missing(wtp_2a_info_584) | !missing(wtp_2a_info_793)
{txt}
{com}.         label var       d1_infofirst "Day 1: magnesium info shown before later tasting/labeled WTP"
{txt}
{com}.         
. ********************************************************************************
. **# 3. Create Day 1 vars for HYP 1
. ********************************************************************************
. 
. * product 584 = HAS MAGNESIUM
. 
.         gen                     d1_mag_overall_like = sensory_584_overall if day1
{txt}(73 missing values generated)

{com}.         gen             d1_mag_flavor_like = sensory_584_flavor  if day1
{txt}(73 missing values generated)

{com}.         gen             d1_mag_lemon_like = sensory_584_lemon   if day1
{txt}(73 missing values generated)

{com}.         gen             d1_mag_sweet_like = sensory_584_sweet   if day1
{txt}(73 missing values generated)

{com}.         gen             d1_mag_refresh = refresh_584         if day1
{txt}(73 missing values generated)

{com}. 
.         label var       d1_mag_overall_like "Day 1 product 584 overall liking"
{txt}
{com}.         label var       d1_mag_flavor_like  "Day 1 product 584 overall flavor liking"
{txt}
{com}.         label var       d1_mag_lemon_like   "Day 1 product 584 lemon-lime flavor liking"
{txt}
{com}.         label var       d1_mag_sweet_like   "Day 1 product 584 sweetness liking"
{txt}
{com}.         label var       d1_mag_refresh      "Day 1 product 584 refreshing sensation"
{txt}
{com}. 
. * product 793 = NO MAGNESIUM
.         gen             d1_nomag_overall_like = sensory_793_overall if day1
{txt}(73 missing values generated)

{com}.         gen             d1_nomag_flavor_like = sensory_793_flavor if day1
{txt}(73 missing values generated)

{com}.         gen             d1_nomag_lemon_like = sensory_793_lemon if day1
{txt}(73 missing values generated)

{com}.         gen             d1_nomag_sweet_like = sensory_793_sweet if day1
{txt}(73 missing values generated)

{com}.         gen             d1_nomag_refresh = refresh_793 if day1
{txt}(73 missing values generated)

{com}.         
.         label var       d1_nomag_overall_like "Day 1 product 793 overall liking"
{txt}
{com}.         label var       d1_nomag_flavor_like  "Day 1 product 793 overall flavor liking"
{txt}
{com}.         label var       d1_nomag_lemon_like   "Day 1 product 793 lemon-lime flavor liking"
{txt}
{com}.         label var       d1_nomag_sweet_like   "Day 1 product 793 sweetness liking"
{txt}
{com}.         label var       d1_nomag_refresh      "Day 1 product 793 refreshing sensation"
{txt}
{com}. * Compare each Day 1 participants rating for the MAGNESIUM drink (584)
. * to the NON-MAGNESIUM drink (793)
. * POSTIVIE values mean participants liked the magnesium MORE
. * NEGATIVE values mean they liked the magnesium LESS
. 
.         gen             d1_diff_overall_like = d1_mag_overall_like - d1_nomag_overall_like if day1
{txt}(73 missing values generated)

{com}.         gen             d1_diff_flavor_like  = d1_mag_flavor_like  - d1_nomag_flavor_like  if day1
{txt}(73 missing values generated)

{com}.         gen             d1_diff_lemon_like   = d1_mag_lemon_like   - d1_nomag_lemon_like   if day1
{txt}(73 missing values generated)

{com}.         gen             d1_diff_sweet_like   = d1_mag_sweet_like   - d1_nomag_sweet_like   if day1
{txt}(73 missing values generated)

{com}.         gen             d1_diff_refresh      = d1_mag_refresh      - d1_nomag_refresh      if day1
{txt}(73 missing values generated)

{com}. 
.         label var       d1_diff_overall_like "Day 1: 584 minus 793 overall liking"
{txt}
{com}.         label var       d1_diff_flavor_like  "Day 1: 584 minus 793 flavor liking"
{txt}
{com}.         label var       d1_diff_lemon_like   "Day 1: 584 minus 793 lemon-lime liking"
{txt}
{com}.         label var       d1_diff_sweet_like   "Day 1: 584 minus 793 sweetness liking"
{txt}
{com}.         label var       d1_diff_refresh      "Day 1: 584 minus 793 refreshing sensation"
{txt}
{com}. 
. ********************************************************************************
. **# Create Day 1 WTP
. ********************************************************************************
. 
. * Generic baseline WTP before product-specific info
.         gen                     wtp_baseline = wtp_1
{txt}
{com}.         label var       wtp_baseline "Baseline WTP for new generic sports beverage"
{txt}
{com}. 
. * Taste-first branch: product-specific WTP before magnesium info
.         gen                     d1_mag_wtp_taste_noinfo   = wtp_2b_584 if day1
{txt}(109 missing values generated)

{com}.         gen             d1_nomag_wtp_taste_noinfo = wtp_2b_793 if day1
{txt}(109 missing values generated)

{com}. 
.         label var       d1_mag_wtp_taste_noinfo   "Day 1 product 584 WTP after taste, before magnesium info"
{txt}
{com}.         label var       d1_nomag_wtp_taste_noinfo "Day 1 product 793 WTP after taste, before magnesium info"
{txt}
{com}. 
.         gen             d1_diff_wtp_taste_noinfo = d1_mag_wtp_taste_noinfo - d1_nomag_wtp_taste_noinfo if day1
{txt}(109 missing values generated)

{com}.         label var       d1_diff_wtp_taste_noinfo "Day 1: 584 minus 793 WTP after taste, before info"
{txt}
{com}. 
. * Unified informed WTP: takes whichever informed WTP exists for each respondent
.         gen             d1_mag_wtp_info = .
{txt}(143 missing values generated)

{com}.         replace         d1_mag_wtp_info = wtp_2a_info_584 if !missing(wtp_2a_info_584)
{txt}(36 real changes made)

{com}.         replace         d1_mag_wtp_info = wtp_3b_info_584 if missing(d1_mag_wtp_info) & !missing(wtp_3b_info_584)
{txt}(34 real changes made)

{com}. 
.         gen             d1_nomag_wtp_info = .
{txt}(143 missing values generated)

{com}.         replace         d1_nomag_wtp_info = wtp_2a_info_793 if !missing(wtp_2a_info_793)
{txt}(36 real changes made)

{com}.         replace         d1_nomag_wtp_info = wtp_3b_info_793 if missing(d1_nomag_wtp_info) & !missing(wtp_3b_info_793)
{txt}(34 real changes made)

{com}. 
.         label var       d1_mag_wtp_info   "Day 1 informed WTP for product 584"
{txt}
{com}.         label var       d1_nomag_wtp_info "Day 1 informed WTP for product 793"
{txt}
{com}. 
.         gen             d1_diff_wtp_info = d1_mag_wtp_info - d1_nomag_wtp_info if day1
{txt}(73 missing values generated)

{com}.         label var       d1_diff_wtp_info "Day 1: 584 minus 793 informed WTP"
{txt}
{com}. 
. * Info-first branch later labeled WTP after tasting
.         gen             d1_mag_wtp_labeled   = wtp_3a_584 if day1
{txt}(107 missing values generated)

{com}.         gen             d1_nomag_wtp_labeled = wtp_3a_793 if day1
{txt}(107 missing values generated)

{com}. 
.         label var       d1_mag_wtp_labeled   "Day 1 labeled WTP for product 584"
{txt}
{com}.         label var       d1_nomag_wtp_labeled "Day 1 labeled WTP for product 793"
{txt}
{com}. 
.         gen             d1_diff_wtp_labeled = d1_mag_wtp_labeled - d1_nomag_wtp_labeled if day1
{txt}(107 missing values generated)

{com}.         label var       d1_diff_wtp_labeled "Day 1: 584 minus 793 labeled WTP"
{txt}
