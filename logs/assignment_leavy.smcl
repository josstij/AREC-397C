.         label var       d1_nomag_overall_like "Day 1 product 793 overall liking"
{txt}
{com}.         label var       d1_nomag_flavor_like  "Day 1 product 793 overall flavor liking"
{txt}
{com}.         label var       d1_nomag_lemon_like   "Day 1 product 793 lemon-lime flavor liking"
{txt}
{com}.         label var       d1_nomag_sweet_like   "Day 1 product 793 sweetness liking"
{txt}
{com}.         label var       d1_nomag_refresh      "Day 1 product 793 refreshing sensation"
{txt}
{com}. * Compare each Day 1 participants rating for the MAGNESIUM drink (584)
. * to the NON-MAGNESIUM drink (793)
. * POSTIVIE values mean participants liked the magnesium MORE
. * NEGATIVE values mean they liked the magnesium LESS
. 
.         gen             d1_diff_overall_like = d1_mag_overall_like - d1_nomag_overall_like if day1
{txt}(77 missing values generated)

{com}.         gen             d1_diff_flavor_like  = d1_mag_flavor_like  - d1_nomag_flavor_like  if day1
{txt}(77 missing values generated)

{com}.         gen             d1_diff_lemon_like   = d1_mag_lemon_like   - d1_nomag_lemon_like   if day1
{txt}(77 missing values generated)

{com}.         gen             d1_diff_sweet_like   = d1_mag_sweet_like   - d1_nomag_sweet_like   if day1
{txt}(77 missing values generated)

{com}.         gen             d1_diff_refresh      = d1_mag_refresh      - d1_nomag_refresh      if day1
{txt}(77 missing values generated)

{com}. 
.         label var       d1_diff_overall_like "Day 1: 584 minus 793 overall liking"
{txt}
{com}.         label var       d1_diff_flavor_like  "Day 1: 584 minus 793 flavor liking"
{txt}
{com}.         label var       d1_diff_lemon_like   "Day 1: 584 minus 793 lemon-lime liking"
{txt}
{com}.         label var       d1_diff_sweet_like   "Day 1: 584 minus 793 sweetness liking"
{txt}
{com}.         label var       d1_diff_refresh      "Day 1: 584 minus 793 refreshing sensation"
{txt}
{com}. 
