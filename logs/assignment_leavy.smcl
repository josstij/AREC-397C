{txt}(33 real changes made)

{com}.         replace         d1_magbenefit_sleep = mag_benefit_3b_d1_sleep ///
>                                 if missing(d1_magbenefit_sleep) & !missing(mag_benefit_3b_d1_sleep)
{txt}(33 real changes made)

{com}. 
