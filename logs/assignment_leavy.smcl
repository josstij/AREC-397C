{txt}
{com}.         label var               h2_outcome "Value"
{txt}
{com}. 
.         table                   (h2_measure) (gender), ///
>                                         statistic(count h2_outcome) ///
>                                         statistic(mean h2_outcome) ///
>                                         statistic(sd h2_outcome) ///
>                                         statistic(min h2_outcome) ///
>                                         statistic(max h2_outcome) ///
>                                         nototal
