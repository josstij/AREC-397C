. **# Figure 1. Taste ratings and pre-information WTP
. ********************************************************************************
. 
. input str20 outcome str15 product mean panel

     {txt}             outcome          product       mean      panel
  1{com}. "Flavor liking"    "Lab beverage" 6.51 1
{txt}  2{com}. "Flavor liking"    "Competitor"   7.10 1
{txt}  3{com}. "Sweetness liking" "Lab beverage" 6.41 1
{txt}  4{com}. "Sweetness liking" "Competitor"   6.90 1
{txt}  5{com}. "Pre-info WTP"     "Lab beverage" 2.62 2
{txt}  6{com}. "Pre-info WTP"     "Competitor"   2.76 2
{txt}  7{com}. end
{txt}
{com}. 
. graph bar mean if panel == 1, ///
>     over(product, label(angle(0))) ///
>     over(outcome, label(angle(0))) ///
>     asyvars ///
>     blabel(bar, format(%4.2f)) ///
>     legend(off) ///
>     ytitle("Mean rating") ///
>     title("Panel A. Mean flavor and sweetness ratings") ///
>     graphregion(color(white)) ///
>     plotregion(color(white)) ///
>     name(g_taste, replace)
{res}{txt}
{com}. 
. graph bar mean if panel == 2, ///
>     over(product, label(angle(0))) ///
>     over(outcome, label(angle(0))) ///
>     asyvars ///
>     blabel(bar, format(%4.2f)) ///
>     legend(off) ///
>     ytitle("Mean willingness to pay ($)") ///
>     title("Panel B. Mean WTP before magnesium information") ///
>     graphregion(color(white)) ///
>     plotregion(color(white)) ///
>     name(g_wtp, replace)
{res}{txt}
{com}. 
. graph combine g_taste g_wtp, ///
>     col(1) ///
>     imargin(2 2 2 2) ///
>     title("Figure 1. Taste ratings and pre-information willingness to pay") ///
>     graphregion(color(white))
{res}{txt}
