. **********************************************************************
. **# 11 - Table 2: One-sample t-tests (Day 1, benchmark = $2.50)
. **********************************************************************
. 
. use "$logs/clean_data_day1_584_793.dta", clear
{txt}
{com}. 
. tempname memhold
{txt}
{com}. postfile `memhold' str50 variable mean tstat pvalue ci_low ci_high ///
>     using "$logs/table2_day1_onesample.dta", replace
{txt}
{com}. 
. foreach var of varlist ///
>     wtp_3b_info_584 ///
>     wtp_3b_info_793 ///
>     wtp_2a_info_584 ///
>     wtp_2a_info_793 {c -(}
{txt}  2{com}. 
.     quietly ttest `var' == 2.5
{txt}  3{com}. 
.     local lab : variable label `var'
{txt}  4{com}.     if "`lab'" == "" local lab "`var'"
{txt}  5{com}. 
.     post `memhold' ///
>         ("`lab'") ///
>         (r(mu_1)) ///
>         (r(t)) ///
>         (r(p)) ///
>         (r(lb_1)) ///
>         (r(ub_1))
{txt}  6{com}. {c )-}
{txt}
{com}. 
. postclose `memhold'
{txt}
{com}. 
. use "$logs/table2_day1_onesample.dta", clear
{txt}
{com}. 
. label variable variable "Variable"
{txt}
{com}. label variable mean "Mean WTP"
{txt}
{com}. label variable tstat "t-statistic"
{txt}
{com}. label variable pvalue "p-value"
{txt}
{com}. label variable ci_low "95% CI (Lower)"
{txt}
{com}. label variable ci_high "95% CI (Upper)"
{txt}
{com}. 
. list, clean noobs
