. **********************************************************************
. **# 13 - Create combined driver variables (Path A + Path B)
. **********************************************************************
. 
. use "$logs/clean_data_day1_584_793.dta", clear
{txt}
{com}. 
. * Combine info usefulness
. gen info_useful = after_info_3b_d1_useful
{txt}(36 missing values generated)

{com}. replace info_useful = after_info_2a_d1_useful if missing(info_useful)
{txt}(36 real changes made)

{com}. 
. * Combine magnesium benefit drivers
. gen mag_muscle = mag_benefit_3b_d1_musle
{txt}(37 missing values generated)

{com}. replace mag_muscle = mag_benefit_2a_d1_muscle if missing(mag_muscle)
{txt}(35 real changes made)

{com}. 
. gen mag_cramps = mag_benefit_3b_d1_cramps
{txt}(37 missing values generated)

{com}. replace mag_cramps = mag_benefit_2a_d1_cramps if missing(mag_cramps)
{txt}(35 real changes made)

{com}. 
. gen mag_sugar = mag_benefit_3b_d1_sugar
{txt}(37 missing values generated)

{com}. replace mag_sugar = mag_benefit_2a_d1_sugar if missing(mag_sugar)
{txt}(35 real changes made)

{com}. 
. gen mag_bone = mag_benefit_3b_d1_bone
{txt}(37 missing values generated)

{com}. replace mag_bone = mag_benefit_2a_d1_bone if missing(mag_bone)
{txt}(34 real changes made)

{com}. 
. gen mag_sleep = mag_benefit_3b_d1_sleep
{txt}(37 missing values generated)

{com}. replace mag_sleep = mag_benefit_2a_d1_sleep if missing(mag_sleep)
{txt}(33 real changes made)

{com}. 
. * Label clearly
. label variable info_useful "Info usefulness (combined A & B)"
{txt}
{com}. label variable mag_muscle "Magnesium: muscle recovery importance"
{txt}
{com}. label variable mag_cramps "Magnesium: cramp reduction importance"
{txt}
{com}. label variable mag_sugar "Magnesium: blood sugar importance"
{txt}
{com}. label variable mag_bone "Magnesium: bone health importance"
{txt}
{com}. label variable mag_sleep "Magnesium: sleep/relaxation importance"
{txt}
{com}. 
. save "$logs/clean_data_day1_drivers.dta", replace
