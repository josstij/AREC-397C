{txt}
{com}.         
.         foreach var of varlist  wtp_3b_info_584 ///
>                                                         wtp_3b_info_793 ///
>                                                         wtp_3b_info_356 ///
>                                                         wtp_3b_info_831 {c -(}
{txt}  2{com}. 
.                 ttest `var' == 2.5
{txt}  3{com}. 
.                 local mean    = r(mu_1)
{txt}  4{com}.                 local tstat   = r(t)
{txt}  5{com}.                 local pvalue  = r(p)
