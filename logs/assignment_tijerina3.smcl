. **# 2 - Create Day 1 WTP change variables using all randomizers
. **********************************************************************
. 
. **## 2.1 - keep Day 1 only
. keep if day == 1
{txt}(73 observations deleted)

{com}. 
. **## 2.2 - B-path: after tasting WTP to after magnesium info WTP
. gen diff_584_b = wtp_3b_info_584 - wtp_2b_584
{txt}(36 missing values generated)

{com}. gen diff_793_b = wtp_3b_info_793 - wtp_2b_793
{txt}(36 missing values generated)

{com}. 
. **## 2.3 - A-path: info-first WTP to later product-specific WTP
. gen diff_584_a = wtp_3a_584 - wtp_2a_info_584
{txt}(34 missing values generated)

{com}. gen diff_793_a = wtp_3a_793 - wtp_2a_info_793
{txt}(34 missing values generated)

{com}. 
. **## 2.4 - combine paths
. gen diff_584 = diff_584_b
{txt}(36 missing values generated)

{com}. replace diff_584 = diff_584_a if missing(diff_584)
{txt}(36 real changes made)

{com}. 
. gen diff_793 = diff_793_b
{txt}(36 missing values generated)

{com}. replace diff_793 = diff_793_a if missing(diff_793)
{txt}(36 real changes made)

{com}. 
