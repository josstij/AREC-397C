{txt}(109 missing values generated)

{com}. 
.         gen diff_356_b = wtp_3b_info_356 - wtp_2b_356
{txt}(105 missing values generated)

{com}.         gen diff_831_b = wtp_3b_info_831 - wtp_2b_831
{txt}(105 missing values generated)

{com}. 
. 
. **## 2.2 - A-path (baseline → info first)
. 
.         gen diff_584_a = wtp_2a_info_584 - wtp_1
{txt}(107 missing values generated)

