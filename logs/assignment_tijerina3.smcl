{txt}(107 missing values generated)

{com}. 
.         gen diff_356_a = wtp_2a_info_356 - wtp_1
{txt}(108 missing values generated)

{com}.         gen diff_831_a = wtp_2a_info_831 - wtp_1
{txt}(108 missing values generated)

{com}. 
. 
