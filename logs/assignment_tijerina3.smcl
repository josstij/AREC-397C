. **********************************************************************
. **# 2 - Create Day 1 WTP variables using all randomizers
. **********************************************************************
. 
. * keep Day 1 only
. keep if day == 1
{txt}(73 observations deleted)

{com}. 
. /*
> Definition of WTP change variables:
> 
> Path B (taste → info):
> diff_584_b = WTP after magnesium info − WTP after tasting
> diff_793_b = WTP after magnesium info − WTP after tasting
> 
> Path A (info → taste):
> diff_584_a = WTP after magnesium info − baseline WTP (wtp_1)
> diff_793_a = WTP after magnesium info − baseline WTP (wtp_1)
> 
> Combined variables:
> diff_584 = uses both A and B observations
> diff_793 = uses both A and B observations
> 
> Positive values = increase in WTP
> Negative values = decrease in WTP
> */
. 
. **## 2.1 - B-path: tasting first, then magnesium info
. gen before_584_b = wtp_2b_584
{txt}(36 missing values generated)

{com}. gen after_584_b  = wtp_3b_info_584
{txt}(36 missing values generated)

{com}. gen diff_584_b   = after_584_b - before_584_b
{txt}(36 missing values generated)

{com}. 
. gen before_793_b = wtp_2b_793
{txt}(36 missing values generated)

{com}. gen after_793_b  = wtp_3b_info_793
{txt}(36 missing values generated)

{com}. gen diff_793_b   = after_793_b - before_793_b
{txt}(36 missing values generated)

{com}. 
. **## 2.2 - A-path: baseline WTP, then magnesium info first
. gen before_584_a = wtp_1
{txt}
{com}. gen after_584_a  = wtp_2a_info_584
{txt}(34 missing values generated)

{com}. gen diff_584_a   = after_584_a - before_584_a
{txt}(34 missing values generated)

{com}. 
. gen before_793_a = wtp_1
{txt}
{com}. gen after_793_a  = wtp_2a_info_793
{txt}(34 missing values generated)

{com}. gen diff_793_a   = after_793_a - before_793_a
{txt}(34 missing values generated)

{com}. 
. **## 2.3 - Combined variables using all randomizers
. gen before_584 = before_584_b
{txt}(36 missing values generated)

{com}. replace before_584 = before_584_a if missing(before_584)
{txt}(36 real changes made)

{com}. 
. gen after_584 = after_584_b
{txt}(36 missing values generated)

{com}. replace after_584 = after_584_a if missing(after_584)
{txt}(36 real changes made)

{com}. 
. gen diff_584 = diff_584_b
{txt}(36 missing values generated)

{com}. replace diff_584 = diff_584_a if missing(diff_584)
{txt}(36 real changes made)

{com}. 
. gen before_793 = before_793_b
{txt}(36 missing values generated)

{com}. replace before_793 = before_793_a if missing(before_793)
{txt}(36 real changes made)

{com}. 
. gen after_793 = after_793_b
{txt}(36 missing values generated)

{com}. replace after_793 = after_793_a if missing(after_793)
{txt}(36 real changes made)

{com}. 
. gen diff_793 = diff_793_b
{txt}(36 missing values generated)

{com}. replace diff_793 = diff_793_a if missing(diff_793)
{txt}(36 real changes made)

{com}. 
. **## 2.4 - Labels
. label variable before_584 "WTP before info: UA Lemon Lime 584"
{txt}
{com}. label variable after_584  "WTP after info: UA Lemon Lime 584"
{txt}
{com}. label variable diff_584   "WTP change: UA Lemon Lime 584"
{txt}
{com}. 
. label variable before_793 "WTP before info: Gatorade 793"
{txt}
{com}. label variable after_793  "WTP after info: Gatorade 793"
{txt}
{com}. label variable diff_793   "WTP change: Gatorade 793"
{txt}
{com}. 
. label variable diff_584_b "WTP change 584: B-path"
{txt}
{com}. label variable diff_584_a "WTP change 584: A-path"
{txt}
{com}. label variable diff_793_b "WTP change 793: B-path"
{txt}
{com}. label variable diff_793_a "WTP change 793: A-path"
{txt}
{com}. 
